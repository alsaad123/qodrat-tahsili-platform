# ==============================================================================
# إعدادات متغيرات البيئة لمنصة تدريب القدرات والتحصيلي
# Environment Configuration for Qodrat & Tahsili Platform
# ==============================================================================

# مفتاح واجهة برمجة تطبيقات Google Gemini (مطلوب لخدمات الذكاء الاصطناعي وفحص الأسئلة)
# Required for Gemini AI features: question generation, OCR scanning, and explanations
# الحصول على المفتاح: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# رابط المنصة أو الخادم الأساسي (يُستخدم لنقاط الاتصال والروابط المرجعية)
# Base application URL used for API endpoints and callbacks
APP_URL="http://localhost:3000"

# منفذ الخادم المحلي (اختياري - القيمة الافتراضية هي 3000)
# Local server port (Optional - default is 3000)
# PORT=3000

